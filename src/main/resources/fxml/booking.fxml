<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.BookingController"
          hgap="10" vgap="15" style="-fx-padding: 30;">
    
    <Label text="Booking" style="-fx-font-size: 22px; -fx-font-weight: bold;" 
           GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
    
    <Label text="Room:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <Label fx:id="roomLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    
    <Label text="Guest Name:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <TextField fx:id="guestNameField" promptText="Enter guest name" 
               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    
    <Label text="Check-in:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <DatePicker fx:id="checkInPicker" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    
    <Label text="Check-out:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <DatePicker fx:id="checkOutPicker" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    
    <Label fx:id="totalLabel" text="Total: $0.0" 
           style="-fx-text-fill: #4ECCA3; -fx-font-weight: bold;" 
           GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    
    <Button fx:id="proceedToPaymentButton" text="Proceed to Payment" 
            style="-fx-background-color: #4ECCA3; -fx-text-fill: white; -fx-font-weight: bold;"
            GridPane.columnIndex="1" GridPane.rowIndex="6"/>
    
</GridPane>
