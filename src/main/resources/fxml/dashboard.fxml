<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.DashboardController">
    
    <!-- Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;" prefWidth="180">
            <Label text="Hotel" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-border-color: white; -fx-border-width: 0 0 2 0; -fx-padding: 5;"/>
            <Button fx:id="roomsButton" text="Rooms" maxWidth="Infinity"/>
            <Button fx:id="reservationsButton" text="Reservations" maxWidth="Infinity"/>
            <Button fx:id="usersButton" text="Users" maxWidth="Infinity"/>
            <Button fx:id="financialsButton" text="Financials" maxWidth="Infinity"/>
            <Button fx:id="logoutButton" text="Log Out" maxWidth="Infinity"/>
        </VBox>
    </left>
    
    <!-- Center Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label text="User Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            
            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ACCOUNT_ID" prefWidth="100"/>
                    <TableColumn fx:id="usernameColumn" text="USERNAME" prefWidth="200"/>
                    <TableColumn fx:id="passwordColumn" text="PASSWORD" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    
</BorderPane>
